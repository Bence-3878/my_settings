{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "padding": {
      "top": 1,
      "right": 3
    }
  },
  "display": {
    "separator": " │ ",
    "bar": {
      "width": 10,
      "char": {
        "elapsed": "■",
        "total": "─"
      }
    },
    "percent": {
      "type": 11
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[36m╭─ Rendszer\u001b[0m"
    },
    {
      "type": "os",
      "key": "│  OS      ",
      "keyColor": "cyan"
    },
    {
      "type": "host",
      "key": "│ 󰌢 Host    ",
      "keyColor": "cyan"
    },
    {
      "type": "kernel",
      "key": "│  Kernel  ",
      "keyColor": "cyan"
    },
    {
      "type": "uptime",
      "key": "│ 󰅐 Uptime  ",
      "keyColor": "cyan"
    },
    {
      "type": "loadavg",
      "key": "│ 󰊚 Terhelés",
      "keyColor": "cyan"
    },
    {
      "type": "packages",
      "key": "│ 󰏖 Csomagok",
      "keyColor": "cyan"
    },
    {
      "type": "custom",
      "format": "\u001b[34m├─ Környezet\u001b[0m"
    },
    {
      "type": "shell",
      "key": "│  Shell   ",
      "keyColor": "blue"
    },
    {
      "type": "de",
      "key": "│ 󰧨 DE      ",
      "keyColor": "blue"
    },
    {
      "type": "wm",
      "key": "│  WM      ",
      "keyColor": "blue"
    },
    {
      "type": "terminal",
      "key": "│  Terminál",
      "keyColor": "blue"
    },
    {
      "type": "display",
      "key": "│ 󰍹 Kijelző ",
      "keyColor": "blue"
    },
    {
      "type": "custom",
      "format": "\u001b[35m├─ Hardver\u001b[0m"
    },
    {
      "type": "cpu",
      "temp": true,
      "key": "│  CPU     ",
      "keyColor": "magenta"
    },
    {
      "type": "gpu",
      "temp": true,
      "key": "│ 󰢮 GPU     ",
      "keyColor": "magenta"
    },
    {
      "type": "memory",
      "key": "│ 󰍛 RAM     ",
      "keyColor": "magenta"
    },
    {
      "type": "swap",
      "key": "│ 󰾴 Swap    ",
      "keyColor": "magenta"
    },
    {
      "type": "disk",
      "folders": "/",
      "key": "│ 󰋊 Lemez   ",
      "keyColor": "magenta"
    },
    {
      "type": "battery",
      "key": "│ 󰁹 Akku    ",
      "keyColor": "magenta"
    },
    {
      "type": "custom",
      "format": "\u001b[32m├─ Hálózat\u001b[0m"
    },
    {
      "type": "wifi",
      "key": "│ 󰖩 Wi-Fi   ",
      "keyColor": "green"
    },
    {
      "type": "localip",
      "compact": true,
      "key": "│ 󰩟 Helyi IP",
      "keyColor": "green"
    },
    {
      "type": "publicip",
      "timeout": 500,
      "key": "│ 󰖟 Külső IP",
      "keyColor": "green"
    },
    {
      "type": "custom",
      "format": "\u001b[32m╰──────────────────────────────\u001b[0m"
    },
    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle"
    },
    "break"
  ]
}
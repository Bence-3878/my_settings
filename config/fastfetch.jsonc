{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "padding": {
      "top": 1,
      "right": 3
    }
  },
  "display": {
    "separator": " │ "
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[36m╭─ Rendszer\u001b[0m"
    },
    {
      "type": "os",
      "key": "│  OS      ",
      "keyColor": "cyan"
    },
    {
      "type": "host",
      "key": "│ 󰌢 Host    ",
      "keyColor": "cyan"
    },
    {
      "type": "kernel",
      "key": "│  Kernel  ",
      "keyColor": "cyan"
    },
    {
      "type": "uptime",
      "key": "│ 󰅐 Uptime  ",
      "keyColor": "cyan"
    },
    {
      "type": "packages",
      "key": "│ 󰏖 Csomagok",
      "keyColor": "cyan"
    },
    {
      "type": "custom",
      "format": "\u001b[34m├─ Környezet\u001b[0m"
    },
    {
      "type": "shell",
      "key": "│  Shell   ",
      "keyColor": "blue"
    },
    {
      "type": "de",
      "key": "│ 󰧨 DE      ",
      "keyColor": "blue"
    },
    {
      "type": "wm",
      "key": "│  WM      ",
      "keyColor": "blue"
    },
    {
      "type": "terminal",
      "key": "│  Terminál",
      "keyColor": "blue"
    },
    {
      "type": "custom",
      "format": "\u001b[35m├─ Hardver\u001b[0m"
    },
    {
      "type": "cpu",
      "key": "│  CPU     ",
      "keyColor": "magenta"
    },
    {
      "type": "gpu",
      "key": "│ 󰢮 GPU     ",
      "keyColor": "magenta"
    },
    {
      "type": "memory",
      "key": "│ 󰍛 RAM     ",
      "keyColor": "magenta"
    },
    {
      "type": "disk",
      "folders": "/",
      "key": "│ 󰋊 Lemez   ",
      "keyColor": "magenta"
    },
    {
      "type": "localip",
      "compact": true,
      "key": "│ 󰩟 Helyi IP",
      "keyColor": "magenta"
    },
    {
      "type": "custom",
      "format": "\u001b[35m╰──────────────────────────────\u001b[0m"
    },
    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle"
    }
  ]
}
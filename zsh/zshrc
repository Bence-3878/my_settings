# Repo útvonal betöltése (link_configs.sh hozza létre)
[[ -f "$HOME/.my_settings_env" ]] && source "$HOME/.my_settings_env"
: "${MY_SETTINGS_DIR:=$HOME/my_settings}"

if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

if [[ -z "${LANG:-}" || "$LANG" == "C" || "$LANG" == "POSIX" ]]; then
  export LANG="C.UTF-8"
fi

export PATH="$MY_SETTINGS_DIR/bin:$HOME/bin:$HOME/.local/bin:/usr/local/bin:$PATH"

export ZSH="$HOME/.oh-my-zsh"
export ZSH_CUSTOM="$ZSH/custom"

if [[ -n $SSH_CONNECTION ]]; then
  export EDITOR='nano'
else
  export EDITOR='micro'
fi
export VIEWER="$EDITOR"
export VISUAL="$EDITOR"
export GIT_EDITOR="$EDITOR"

ZSH_THEME="my"
HYPHEN_INSENSITIVE="true"
COMPLETION_WAITING_DOTS="true"
HIST_STAMPS="yyyy-mm-dd"

zstyle ':omz:update' mode auto
zstyle ':omz:update' frequency 7
zstyle ':omz:plugins:ssh-agent' identities id_ecdsa
zstyle ':omz:plugins:ssh-agent' lifetime 4h
zstyle ':omz:plugins:ssh-agent' agent-forwarding on
zstyle ':omz:plugins:ssh-agent' quiet yes

plugins=(
  git
  sudo
  web-search
  virtualenv
  ${commands[ssh-agent]:+ssh-agent}
  copyfile
  copypath
  fzf
  extract
  colored-man-pages
  dirhistory
  command-not-found
  systemd
  zsh-z
  you-should-use
  zsh-autopair
  fzf-tab
  zsh-autosuggestions
  zsh-history-substring-search
  zsh-syntax-highlighting

)

[[ -d "$HOME/.ssh" ]] || mkdir -p -m 700 "$HOME/.ssh"

ZSH_DISABLE_COMPFIX="true"

source "$ZSH/oh-my-zsh.sh"

if [[ "$MY_SETTINGS_PROFILE" == "server" ]] \
   && [[ -z "$TMUX" ]] \
   && [[ -o interactive ]] \
   && command -v tmux &>/dev/null; then
  exec tmux new-session -A -s main
fi

[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

if [[ "$TERM" == "linux" ]]; then
  for _s in /sys/class/drm/card*-*/status(N); do
    [[ "$(<"$_s")" == "connected" ]] || continue
    _dir="${_s%/status}"
    _res=$(head -n1 "$_dir/modes" 2>/dev/null)
    read _w_cm _h_cm <<< $(od -An -tu1 -j 21 -N 2 "$_dir/edid" 2>/dev/null)
    if (( ${_w_cm:-0} > 0 && (${_res%x*} * 254 / (_w_cm * 100)) > 130 )); then
      setfont Lat15-Terminus32x16 2>/dev/null
      break
    fi
  done
  unset _s _dir _res _w_cm _h_cm
fi

[[ -f "$MY_SETTINGS_DIR/zsh/aliases.local.zsh" ]] && source "$MY_SETTINGS_DIR/zsh/aliases.local.zsh"
[[ -f "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"

# Added by Antigravity CLI installer
export PATH="/home/pako/.local/bin:$PATH"
